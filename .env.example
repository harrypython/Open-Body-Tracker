# Environment Configuration for Open Body Tracker
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_USER=obtracker
POSTGRES_PASSWORD=obtracker_secure_password_change_me
POSTGRES_DB=open_body_tracker

# Security (CHANGE IN PRODUCTION) openssl rand -hex 32 | pbcopy
SECRET_KEY=your-super-secret-key-change-me-in-production-min-32-chars

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Application Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30