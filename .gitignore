```gitignore
# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Build artifacts
dist/
build/
*.js.map
*.ts.map

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Environment files
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
coverage/
htmlcov/
*.coverage

# Temporary files
*.tmp
Thumbs.db
.DS_Store

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled JavaScript
*.min.js
bundle.js
*.bundle.js

# Authentication context related
*.key
*.cert
*.pem
```